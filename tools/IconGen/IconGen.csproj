<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Procedural logo generator for JsonNotepad.
    Regenerates the application icon, the MSIX visual assets and the README logo:
      build/generate-icons.ps1   (or run the built IconGen.exe with an optional output root)
    UseWindowsForms is only enabled to get System.Drawing (GDI+) without a NuGet package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>JsonNotepad.Tools.IconGen</RootNamespace>
    <AssemblyName>IconGen</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
