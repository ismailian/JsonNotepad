<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application shell: main window, dialogs, settings, command routing. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>JsonNotepad.App</RootNamespace>
    <AssemblyName>JsonNotepad</AssemblyName>
    <AssemblyTitle>JsonNotepad</AssemblyTitle>
    <Description>A fast tree-based viewer and editor for JSON files.</Description>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <!-- Loading builds millions of long-lived objects on a worker thread. Server GC cut load
         time by ~40% in our benchmarks (docs/performance.md); since .NET 9 it runs with DATAS
         (dynamic adaptation), which keeps the heap small for small documents, so it no longer
         carries the classic "server GC hogs memory" cost for a desktop app. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\AppIcon.ico" LogicalName="JsonNotepad.AppIcon.ico" Condition="Exists('Resources\AppIcon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonNotepad.Core\JsonNotepad.Core.csproj" />
    <ProjectReference Include="..\JsonNotepad.Controls\JsonNotepad.Controls.csproj" />
  </ItemGroup>

</Project>
